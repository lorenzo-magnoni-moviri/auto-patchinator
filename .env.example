# Copy to .env and fill in, or just leave .env missing/incomplete entirely - `run`
# now checks this up front and interactively prompts for (then saves) anything left
# blank, chmod'ing the result to 600 for you. This file is gitignored - never commit
# .env. Terminal input for these prompts is never masked (operator's preference).

# Use your own Splunk/LDAP login here - the same credentials you use day to day.
AP_USERNAME=your_ldap_username
AP_PASSWORD=your_pas_password

# Optional: Splunk REST API credentials, used by the pre-patch pretest (search-head
# captain/election + KV store checks) and the post-restart cluster-health poll
# (CLUSTER_WAIT). Leave unset to skip those checks entirely (never degrades - see
# preflight.py). Prefer a token over username/password if your Splunk deployment
# issues one. SPLUNK_API_USER is virtually always the Splunk admin account - the
# interactive .env prompt defaults to "admin" for it if left blank.
# NEVER hardcode these values in source or commit history - only via this file.
SPLUNK_API_TOKEN=
SPLUNK_API_USER=
SPLUNK_API_PASSWORD=

# Optional: StreamSets Data Collector REST API credentials (HTTP Basic auth), used to
# automate pipeline stop/start on prdmilbbspkfw02 (HOST_OVERRIDES in
# actions/sequences.py). Leave unset to keep that step manual.
# NEVER hardcode these values in source or commit history - only via this file.
STREAMSETS_API_USER=
STREAMSETS_API_PASSWORD=
